//@version=5
// =============================================================================
//  ICC + OTE — MTF Indicator / Alerts edition
//  Same top-down logic as the strategy (1D bias · 4H confirm · 1H entry) but as
//  an indicator: plots the OTE zone, FVG / order-block boxes, a bias table, and
//  fires alertcondition() signals you can forward to the webhook bridge.
//
//  Apply on your 1H entry chart. Educational template — not financial advice.
// =============================================================================
indicator("ICC + OTE — MTF Alerts", shorttitle="ICC-OTE MTF Alerts", overlay=true,
     max_boxes_count=20, max_lines_count=20, max_labels_count=200)

// ------------------------------ Inputs ---------------------------------------
tfBias    = input.timeframe("1D",  "Bias timeframe (structure)")
tfConfirm = input.timeframe("240", "Confirmation timeframe (4H)")
oteSource = input.string("Confirmation", "Draw OTE / Fib on", options=["Bias", "Confirmation"])
pivotLen  = input.int(5, "Swing lookback (pivots)", minval=2)
fibLow    = input.float(0.62, "OTE shallow (fib)", minval=0.3, maxval=0.99, step=0.01)
fibHigh   = input.float(0.79, "OTE deep (fib)",    minval=0.3, maxval=0.99, step=0.01)
useFVG    = input.bool(true,  "Require 1H FVG confluence")
allowLong  = input.bool(true, "Allow longs")
allowShort = input.bool(true, "Allow shorts")
showZone  = input.bool(true, "Show OTE zone + Fib")
showFVG   = input.bool(true, "Show 1H FVG box")
showOB    = input.bool(true, "Show 1H order block")
showTable = input.bool(true, "Show bias table")

// --------------------- HTF structure (Indication) ----------------------------
f_structure() =>
    ph = ta.pivothigh(pivotLen, pivotLen)
    pl = ta.pivotlow(pivotLen, pivotLen)
    var float lastPH = na
    var float prevPH = na
    var float lastPL = na
    var float prevPL = na
    if not na(ph)
        prevPH := lastPH
        lastPH := ph
    if not na(pl)
        prevPL := lastPL
        lastPL := pl
    bull = not na(ph) and not na(prevPH) and ph > prevPH and not na(lastPL)
    bear = not na(pl) and not na(prevPL) and pl < prevPL and not na(lastPH)
    var int   b  = 0
    var float lh = na
    var float ll = na
    if bull
        b  := 1
        lh := ph
        ll := lastPL
    if bear
        b  := -1
        ll := pl
        lh := lastPH
    [b, lh, ll]

[biasD, legHiD, legLoD] = request.security(syminfo.tickerid, tfBias,    f_structure(), lookahead=barmerge.lookahead_off)
[bias4, legHi4, legLo4] = request.security(syminfo.tickerid, tfConfirm, f_structure(), lookahead=barmerge.lookahead_off)

aligned = not na(biasD) and biasD != 0 and biasD == bias4
dir     = aligned ? biasD : 0

useBiasLeg = oteSource == "Bias"
legHi = useBiasLeg ? legHiD : legHi4
legLo = useBiasLeg ? legLoD : legLo4

// -------------------------- OTE zone (Correction) ----------------------------
rng     = na(legHi) or na(legLo) ? na : legHi - legLo
oteShal = na(rng) ? na : dir == 1 ? legHi - rng * fibLow : dir == -1 ? legLo + rng * fibLow : na
oteDeep = na(rng) ? na : dir == 1 ? legHi - rng * fibHigh : dir == -1 ? legLo + rng * fibHigh : na
oteMid  = na(rng) ? na : dir == 1 ? legHi - rng * 0.705   : dir == -1 ? legLo + rng * 0.705   : na

var bool  entered   = false
var float prevLegHi = na
var float prevLegLo = na
if legHi != prevLegHi or legLo != prevLegLo
    entered := false
prevLegHi := legHi
prevLegLo := legLo

// --------------------- 1H confluence: FVG + Order Block -----------------------
bullFVG = low  > high[2]
bearFVG = high < low[2]
fvgWindow  = 30
hasBullFVG = ta.barssince(bullFVG) <= fvgWindow
hasBearFVG = ta.barssince(bearFVG) <= fvgWindow

var float bullOBhi = na
var float bullOBlo = na
var float bearOBhi = na
var float bearOBlo = na
if bullFVG
    obi = close[2] < open[2] ? 2 : close[3] < open[3] ? 3 : 2
    bullOBhi := high[obi]
    bullOBlo := low[obi]
if bearFVG
    obi = close[2] > open[2] ? 2 : close[3] > open[3] ? 3 : 2
    bearOBhi := high[obi]
    bearOBlo := low[obi]

// ------------------------------- Signals -------------------------------------
inZoneLong  = dir == 1  and not na(oteShal) and low  <= oteShal and low  > legLo
inZoneShort = dir == -1 and not na(oteShal) and high >= oteShal and high < legHi
longSig  = allowLong  and inZoneLong  and (not useFVG or hasBullFVG) and not entered
shortSig = allowShort and inZoneShort and (not useFVG or hasBearFVG) and not entered
if longSig or shortSig
    entered := true

// ------------------------------- Markup --------------------------------------
zoneCol = dir == 1 ? color.new(color.teal, 80) : dir == -1 ? color.new(color.red, 80) : na
pShal = plot(showZone and dir != 0 ? oteShal : na, "OTE 0.62", color=color.new(color.gray, 0), style=plot.style_linebr)
pDeep = plot(showZone and dir != 0 ? oteDeep : na, "OTE 0.79", color=color.new(color.gray, 0), style=plot.style_linebr)
fill(pShal, pDeep, color=showZone ? zoneCol : na, title="OTE zone")
plot(showZone and dir != 0 ? oteMid : na, "OTE 0.705", color=color.new(color.orange, 0), style=plot.style_linebr)

if showFVG and bullFVG
    box.new(bar_index[2], low[0], bar_index + 3, high[2], border_color=color.new(color.teal, 40), bgcolor=color.new(color.teal, 88))
if showFVG and bearFVG
    box.new(bar_index[2], low[2], bar_index + 3, high[0], border_color=color.new(color.red, 40), bgcolor=color.new(color.red, 88))
if showOB and bullFVG and not na(bullOBlo)
    box.new(bar_index - 3, bullOBhi, bar_index + 3, bullOBlo, border_color=color.new(color.green, 20), bgcolor=color.new(color.green, 85))
if showOB and bearFVG and not na(bearOBlo)
    box.new(bar_index - 3, bearOBhi, bar_index + 3, bearOBlo, border_color=color.new(color.maroon, 20), bgcolor=color.new(color.maroon, 85))

plotshape(longSig,  title="Long entry",  style=shape.labelup,   location=location.belowbar, color=color.teal, text="ICC▲", textcolor=color.white, size=size.small)
plotshape(shortSig, title="Short entry", style=shape.labeldown, location=location.abovebar, color=color.red,  text="ICC▼", textcolor=color.white, size=size.small)

f_arrow(b) => b == 1 ? "▲ Bull" : b == -1 ? "▼ Bear" : "– None"
f_col(b)   => b == 1 ? color.teal : b == -1 ? color.red : color.gray
if showTable and barstate.islast
    var table t = table.new(position.top_right, 2, 4, border_width=1)
    table.cell(t, 0, 0, "Bias " + tfBias,       text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 0, f_arrow(biasD),          text_color=f_col(biasD), bgcolor=color.new(color.black, 30))
    table.cell(t, 0, 1, "Confirm " + tfConfirm,  text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 1, f_arrow(bias4),          text_color=f_col(bias4), bgcolor=color.new(color.black, 30))
    table.cell(t, 0, 2, "Aligned",               text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 2, aligned ? "YES" : "no",  text_color=aligned ? color.teal : color.gray, bgcolor=color.new(color.black, 30))
    table.cell(t, 0, 3, "Setup",                 text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 3, dir == 1 ? "LONG" : dir == -1 ? "SHORT" : "wait", text_color=f_col(dir), bgcolor=color.new(color.black, 30))

// ------------------------------- Alerts --------------------------------------
alertcondition(longSig,  title="ICC-OTE MTF Long",  message='{"strategy":"ICC-OTE-MTF","ticker":"{{ticker}}","action":"buy","price":{{close}},"bias":"1D+4H bull","tf":"{{interval}}"}')
alertcondition(shortSig, title="ICC-OTE MTF Short", message='{"strategy":"ICC-OTE-MTF","ticker":"{{ticker}}","action":"sell","price":{{close}},"bias":"1D+4H bear","tf":"{{interval}}"}')
