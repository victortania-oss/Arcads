//@version=5
// =============================================================================
//  ICC + OTE  —  Multi-Timeframe (Top-Down)
//  Indication · Correction · Continuation  ·  ICT (FVG / Order Blocks) · OTE Fib
// -----------------------------------------------------------------------------
//  TOP-DOWN WORKFLOW (apply this script on your 1H entry chart)
//    1D  BIAS     -> higher-timeframe structure sets the directional bias
//    4H  CONFIRM  -> 4H structure must MATCH the 1D bias, or no trade is armed
//    4H  MARKUP   -> Fibonacci / OTE zone (0.62–0.79) drawn on the 4H leg
//    1H  ENTRY    -> enter when price taps the OTE zone with FVG / order-block
//                    confluence, in the direction of the aligned HTF bias
//
//  Educational template — NOT financial advice. Backtest and demo-test first.
//  See docs/ICC_STRATEGY.md and docs/RISK.md.
// =============================================================================
strategy(
     title             = "ICC + OTE — MTF (1D/4H/1H)",
     shorttitle        = "ICC-OTE MTF",
     overlay           = true,
     initial_capital   = 10000,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 10,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.02,
     slippage          = 1,
     pyramiding        = 0,
     max_boxes_count   = 20,
     max_lines_count   = 20,
     process_orders_on_close = true,
     calc_on_order_fills     = true)

// ------------------------------ Inputs ---------------------------------------
grpMTF    = "① Timeframes (top-down)"
tfBias    = input.timeframe("1D",  "Bias timeframe (structure)", group=grpMTF,
     tooltip="Higher timeframe that sets directional bias. You scan 1D first.")
tfConfirm = input.timeframe("240", "Confirmation timeframe", group=grpMTF,
     tooltip="Must agree with the bias timeframe. Default 240 = 4H.")
oteSource = input.string("Confirmation", "Draw OTE / Fib on", options=["Bias", "Confirmation"], group=grpMTF,
     tooltip="Which HTF leg to draw the OTE zone on. Default = 4H (Confirmation).")
// Entry timeframe = the chart you apply this on (intended: 1H).

grpStruct = "② Structure"
pivotLen  = input.int(5, "Swing lookback (pivots)", minval=2, group=grpStruct,
     tooltip="Bars each side to confirm an HTF swing. Higher = fewer, stronger swings.")

grpOte  = "③ OTE / Correction"
fibLow  = input.float(0.62, "OTE shallow (fib)", minval=0.3, maxval=0.99, step=0.01, group=grpOte)
fibHigh = input.float(0.79, "OTE deep (fib)",    minval=0.3, maxval=0.99, step=0.01, group=grpOte)
useFVG  = input.bool(true,  "Require 1H Fair Value Gap confluence", group=grpOte,
     tooltip="Only enter when a fair value gap formed on the entry (chart) timeframe.")

grpRisk    = "④ Risk / Continuation"
slBufTicks = input.float(4, "Stop buffer (ticks beyond leg)", minval=0, group=grpRisk)
rr         = input.float(2.5, "Target (R multiple)", minval=0.5, step=0.1, group=grpRisk)

grpDir  = "⑤ Direction"
allowLong  = input.bool(true, "Allow longs",  group=grpDir)
allowShort = input.bool(true, "Allow shorts", group=grpDir)

grpViz  = "⑥ Markup"
showZone  = input.bool(true, "Show OTE zone + Fib", group=grpViz)
showFVG   = input.bool(true, "Show 1H FVG box",     group=grpViz)
showOB    = input.bool(true, "Show 1H order block", group=grpViz)
showTable = input.bool(true, "Show bias table",     group=grpViz)

// --------------------- HTF structure (Indication) ----------------------------
// Runs on the requested timeframe and returns [bias, legHigh, legLow].
// bias: 1 bullish, -1 bearish, 0 none. Leg = the impulse that broke structure.
f_structure() =>
    ph = ta.pivothigh(pivotLen, pivotLen)
    pl = ta.pivotlow(pivotLen, pivotLen)
    var float lastPH = na
    var float prevPH = na
    var float lastPL = na
    var float prevPL = na
    if not na(ph)
        prevPH := lastPH
        lastPH := ph
    if not na(pl)
        prevPL := lastPL
        lastPL := pl
    bull = not na(ph) and not na(prevPH) and ph > prevPH and not na(lastPL)
    bear = not na(pl) and not na(prevPL) and pl < prevPL and not na(lastPH)
    var int   b  = 0
    var float lh = na
    var float ll = na
    if bull
        b  := 1
        lh := ph
        ll := lastPL
    if bear
        b  := -1
        ll := pl
        lh := lastPH
    [b, lh, ll]

[biasD, legHiD, legLoD] = request.security(syminfo.tickerid, tfBias,    f_structure(), lookahead=barmerge.lookahead_off)
[bias4, legHi4, legLo4] = request.security(syminfo.tickerid, tfConfirm, f_structure(), lookahead=barmerge.lookahead_off)

// Bias must align across 1D and 4H.
aligned = not na(biasD) and biasD != 0 and biasD == bias4
dir     = aligned ? biasD : 0

// Choose which HTF leg carries the OTE / Fib markup.
useBiasLeg = oteSource == "Bias"
legHi = useBiasLeg ? legHiD : legHi4
legLo = useBiasLeg ? legLoD : legLo4

// -------------------------- OTE zone (Correction) ----------------------------
rng     = na(legHi) or na(legLo) ? na : legHi - legLo
oteShal = na(rng) ? na : dir == 1 ? legHi - rng * fibLow : dir == -1 ? legLo + rng * fibLow : na
oteDeep = na(rng) ? na : dir == 1 ? legHi - rng * fibHigh : dir == -1 ? legLo + rng * fibHigh : na
oteMid  = na(rng) ? na : dir == 1 ? legHi - rng * 0.705   : dir == -1 ? legLo + rng * 0.705   : na

// Reset the "already entered this leg" flag whenever the HTF leg changes.
var bool  entered   = false
var float prevLegHi = na
var float prevLegLo = na
if legHi != prevLegHi or legLo != prevLegLo
    entered := false
prevLegHi := legHi
prevLegLo := legLo

// --------------------- 1H confluence: FVG + Order Block -----------------------
// Fair value gaps on the entry (chart) timeframe.
bullFVG = low  > high[2]
bearFVG = high < low[2]
fvgWindow  = 30
hasBullFVG = ta.barssince(bullFVG) <= fvgWindow
hasBearFVG = ta.barssince(bearFVG) <= fvgWindow

// Approximate order block: the last opposite-color candle before a displacement.
var float bullOBhi = na
var float bullOBlo = na
var float bearOBhi = na
var float bearOBlo = na
if bullFVG
    obi = close[2] < open[2] ? 2 : close[3] < open[3] ? 3 : 2
    bullOBhi := high[obi]
    bullOBlo := low[obi]
if bearFVG
    obi = close[2] > open[2] ? 2 : close[3] > open[3] ? 3 : 2
    bearOBhi := high[obi]
    bearOBlo := low[obi]

// ------------------------------- Entries -------------------------------------
inZoneLong  = dir == 1  and not na(oteShal) and low  <= oteShal and low  > legLo
inZoneShort = dir == -1 and not na(oteShal) and high >= oteShal and high < legHi

longSig  = allowLong  and inZoneLong  and (not useFVG or hasBullFVG) and not entered and strategy.position_size == 0
shortSig = allowShort and inZoneShort and (not useFVG or hasBearFVG) and not entered and strategy.position_size == 0

if longSig
    entryP = close
    sl     = legLo - slBufTicks * syminfo.mintick
    risk   = entryP - sl
    tp     = entryP + risk * rr
    strategy.entry("Long", strategy.long)
    strategy.exit("Long exit", "Long", stop=sl, limit=tp)
    entered := true
    alert('{"strategy":"ICC-OTE-MTF","ticker":"' + syminfo.tickerid + '","action":"buy","price":' + str.tostring(entryP) + ',"sl":' + str.tostring(sl) + ',"tp":' + str.tostring(tp) + ',"bias":"1D+4H bull","tf":"' + timeframe.period + '"}', alert.freq_once_per_bar)

if shortSig
    entryP = close
    sl     = legHi + slBufTicks * syminfo.mintick
    risk   = sl - entryP
    tp     = entryP - risk * rr
    strategy.entry("Short", strategy.short)
    strategy.exit("Short exit", "Short", stop=sl, limit=tp)
    entered := true
    alert('{"strategy":"ICC-OTE-MTF","ticker":"' + syminfo.tickerid + '","action":"sell","price":' + str.tostring(entryP) + ',"sl":' + str.tostring(sl) + ',"tp":' + str.tostring(tp) + ',"bias":"1D+4H bear","tf":"' + timeframe.period + '"}', alert.freq_once_per_bar)

// ------------------------------- Markup --------------------------------------
zoneCol = dir == 1 ? color.new(color.teal, 80) : dir == -1 ? color.new(color.red, 80) : na
pShal = plot(showZone and dir != 0 ? oteShal : na, "OTE 0.62", color=color.new(color.gray, 0), style=plot.style_linebr)
pDeep = plot(showZone and dir != 0 ? oteDeep : na, "OTE 0.79", color=color.new(color.gray, 0), style=plot.style_linebr)
fill(pShal, pDeep, color=showZone ? zoneCol : na, title="OTE zone")
plot(showZone and dir != 0 ? oteMid : na, "OTE 0.705", color=color.new(color.orange, 0), style=plot.style_linebr)
plot(showZone and dir != 0 ? legHi  : na, "Leg high", color=color.new(color.blue, 50), style=plot.style_linebr)
plot(showZone and dir != 0 ? legLo  : na, "Leg low",  color=color.new(color.blue, 50), style=plot.style_linebr)

// FVG box (entry timeframe)
if showFVG and bullFVG
    box.new(bar_index[2], low[0], bar_index + 3, high[2], border_color=color.new(color.teal, 40), bgcolor=color.new(color.teal, 88))
if showFVG and bearFVG
    box.new(bar_index[2], low[2], bar_index + 3, high[0], border_color=color.new(color.red, 40), bgcolor=color.new(color.red, 88))

// Order-block box (entry timeframe)
if showOB and bullFVG and not na(bullOBlo)
    box.new(bar_index - 3, bullOBhi, bar_index + 3, bullOBlo, border_color=color.new(color.green, 20), bgcolor=color.new(color.green, 85))
if showOB and bearFVG and not na(bearOBlo)
    box.new(bar_index - 3, bearOBhi, bar_index + 3, bearOBlo, border_color=color.new(color.maroon, 20), bgcolor=color.new(color.maroon, 85))

plotshape(longSig,  title="Long entry",  style=shape.labelup,   location=location.belowbar, color=color.teal, text="ICC▲", textcolor=color.white, size=size.small)
plotshape(shortSig, title="Short entry", style=shape.labeldown, location=location.abovebar, color=color.red,  text="ICC▼", textcolor=color.white, size=size.small)

// Bias table
f_arrow(b) => b == 1 ? "▲ Bull" : b == -1 ? "▼ Bear" : "– None"
f_col(b)   => b == 1 ? color.teal : b == -1 ? color.red : color.gray
if showTable and barstate.islast
    var table t = table.new(position.top_right, 2, 4, border_width=1)
    table.cell(t, 0, 0, "Bias " + tfBias,    text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 0, f_arrow(biasD),       text_color=f_col(biasD), bgcolor=color.new(color.black, 30))
    table.cell(t, 0, 1, "Confirm " + tfConfirm, text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 1, f_arrow(bias4),       text_color=f_col(bias4), bgcolor=color.new(color.black, 30))
    table.cell(t, 0, 2, "Aligned",            text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 2, aligned ? "YES" : "no", text_color=aligned ? color.teal : color.gray, bgcolor=color.new(color.black, 30))
    table.cell(t, 0, 3, "Setup",              text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 3, dir == 1 ? "LONG" : dir == -1 ? "SHORT" : "wait", text_color=f_col(dir), bgcolor=color.new(color.black, 30))
