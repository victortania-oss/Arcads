//@version=5
// =============================================================================
//  ICC + OTE  —  Multi-Timeframe (Top-Down)
//  Indication · Correction · Continuation  ·  ICT (FVG / Order Blocks) · OTE Fib
// -----------------------------------------------------------------------------
//  TOP-DOWN WORKFLOW (apply this script on your 1H entry chart)
//    1D  BIAS     -> higher-timeframe structure sets the directional bias
//    4H  CONFIRM  -> 4H structure must MATCH the 1D bias, or no trade is armed
//    4H  MARKUP   -> Fibonacci / OTE zone (0.62–0.79) drawn on the 4H leg
//    1H  ENTRY    -> enter when price taps the OTE zone with FVG / order-block
//                    confluence, in the direction of the aligned HTF bias
//
//  Educational template — NOT financial advice. Backtest and demo-test first.
//  See docs/ICC_STRATEGY.md and docs/RISK.md.
// =============================================================================
strategy(
     title             = "ICC + OTE — MTF (1D/4H/1H)",
     shorttitle        = "ICC-OTE MTF",
     overlay           = true,
     initial_capital   = 10000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.02,
     slippage          = 1,
     pyramiding        = 0,
     max_boxes_count   = 20,
     max_lines_count   = 20,
     process_orders_on_close = true,
     calc_on_order_fills     = true)

// ------------------------------ Inputs ---------------------------------------
grpMTF    = "① Timeframes (top-down)"
tfBias    = input.timeframe("1D",  "Bias timeframe (structure)", group=grpMTF,
     tooltip="Higher timeframe that sets directional bias. You scan 1D first.")
tfConfirm = input.timeframe("240", "Confirmation timeframe", group=grpMTF,
     tooltip="Must agree with the bias timeframe. Default 240 = 4H.")
oteSource = input.string("Confirmation", "Draw OTE / Fib on", options=["Bias", "Confirmation"], group=grpMTF,
     tooltip="Which HTF leg to draw the OTE zone on. Default = 4H (Confirmation).")
// Entry timeframe = the chart you apply this on (intended: 1H).

grpStruct = "② Structure"
pivotLen  = input.int(5, "Swing lookback (pivots)", minval=2, group=grpStruct,
     tooltip="Bars each side to confirm an HTF swing. Higher = fewer, stronger swings.")

grpOte  = "③ OTE / Correction"
useFVG  = input.bool(true,  "Require 1H Fair Value Gap confluence", group=grpOte,
     tooltip="Only enter when a fair value gap formed on the entry (chart) timeframe.")
autoEntry  = input.bool(true, "Auto-pick shallowest entry meeting min R:R", group=grpOte,
     tooltip="Evaluate the entry levels shallow→deep and place the limit at the SHALLOWEST that still gives at least the minimum R:R to the target. Off = use the manual level below.")
fibA       = input.float(0.618, "Entry A — shallow", minval=0.4, maxval=0.95, step=0.001, group=grpOte)
fibB       = input.float(0.705, "Entry B — common",  minval=0.4, maxval=0.95, step=0.001, group=grpOte)
fibC       = input.float(0.786, "Entry C — deep",    minval=0.4, maxval=0.95, step=0.001, group=grpOte)
manualEntry = input.string("0.705 (B)", "Manual entry level (auto off)", options=["0.618 (A)", "0.705 (B)", "0.786 (C)"], group=grpOte)
targetExt  = input.float(0.0, "R:R target beyond leg extreme (× leg)", minval=0.0, step=0.1, group=grpOte,
     tooltip="Target used for the R:R gate. 0 = the leg extreme (reclaim the high/low). Raise it to require R:R measured to liquidity beyond the leg.")
requirePD  = input.bool(true, "Require correct Premium/Discount", group=grpOte,
     tooltip="Longs only in discount (below the 50% equilibrium of the leg), shorts only in premium. Confluences respected in the right zone = higher probability.")
requirePocketConf = input.bool(true, "Require a confluence AT the entry zone", group=grpOte,
     tooltip="Only enter if the 0.618–0.786 entry zone overlaps a confluence ZONE — FVG, inverse FVG, rejection block, or order block — not merely present nearby.")
confWin    = input.int(40, "Confluence zone valid for N bars", minval=5, group=grpOte,
     tooltip="A confluence zone counts for the overlap test only if it formed within this many bars.")
volLen     = input.int(20, "Volume average length", minval=1, group=grpOte)
volMult    = input.float(1.0, "Volume threshold (× average)", minval=0.1, step=0.1, group=grpOte,
     tooltip="Entry-bar volume must exceed this multiple of its average to count as a volume confluence.")
requireVol = input.bool(false, "Require above-average volume (hard filter)", group=grpOte,
     tooltip="On = never trade without above-average volume. Off = volume is a strong (double-weighted) confluence but not mandatory.")
minConfl   = input.int(2, "Minimum confluences to trade", minval=0, maxval=5, group=grpOte,
     tooltip="Quality gate. Score = FVG + order-block retest + liquidity sweep + (volume counts double). Only setups scoring at least this fire — so with a small daily cap you take the best.")

grpLiq       = "③b Liquidity sweep"
useSweep     = input.bool(false, "Require liquidity sweep before entry", group=grpLiq,
     tooltip="ICT refinement: only take the entry if the correction first swept a prior 1H swing low (longs) / high (shorts) and closed back inside — a stop raid.")
sweepPivotLen = input.int(3, "Minor swing lookback (1H)", minval=1, group=grpLiq,
     tooltip="Bars each side for the minor 1H swings whose liquidity must be swept.")
sweepWindow  = input.int(10, "Sweep valid for N bars", minval=1, group=grpLiq,
     tooltip="How recently the sweep must have happened for the entry to still count.")

grpRisk    = "④ Risk / Continuation"
riskPct    = input.float(1.0, "Risk per trade (% of equity)", minval=0.05, maxval=100, step=0.1, group=grpRisk,
     tooltip="Position size is calculated so a full stop-out loses this % of account equity. Default 1%.")
roundContr = input.bool(true, "Round size to whole contracts", group=grpRisk,
     tooltip="On for futures (MNQ/MES) — sizes down to whole contracts. Off for crypto/forex where fractional size is allowed.")
minRR      = input.float(2.0, "Minimum R:R (skip if runner target < this)", minval=0.5, step=0.1, group=grpRisk,
     tooltip="Only take a setup if the final (runner) target is at least this multiple of risk. Default 2:1.")
maxTrades  = input.int(2, "Max trades per day", minval=1, maxval=20, group=grpRisk,
     tooltip="Stop taking new entries once this many have filled today. Resets each new day.")
slBufTicks = input.float(4, "Stop buffer (ticks beyond leg)", minval=0, group=grpRisk)
numTPs     = input.int(3, "Take-profit tranches", minval=1, maxval=3, group=grpRisk,
     tooltip="Scale out over 1–3 targets. With 3, the final tranche runs risk-free after break-even.")
tp1R       = input.float(1.0, "TP1 (R)", minval=0.1, step=0.1, group=grpRisk)
tp2R       = input.float(2.0, "TP2 (R)", minval=0.1, step=0.1, group=grpRisk)
tp3R       = input.float(4.0, "TP3 (R) — runner", minval=0.1, step=0.1, group=grpRisk)
tp1pct     = input.float(50, "Close at TP1 (%)", minval=0, maxval=100, step=5, group=grpRisk)
tp2pct     = input.float(30, "Close at TP2 (%)", minval=0, maxval=100, step=5, group=grpRisk,
     tooltip="TP3 closes whatever remains (100 − TP1% − TP2%).")
moveBE     = input.bool(true, "Move stop to break-even after TP1", group=grpRisk)
beOffTicks = input.float(0, "Break-even offset (ticks)", minval=0, group=grpRisk,
     tooltip="Nudge the break-even stop past entry to cover commissions/slippage, so the runner is truly risk-free.")
trailTP2   = input.bool(true, "Trail stop up to TP1 after TP2 hits", group=grpRisk,
     tooltip="After TP2 fills, lock in profit by moving the stop up to the TP1 price on the remaining runner.")

grpDir  = "⑤ Direction"
allowLong  = input.bool(true, "Allow longs",  group=grpDir)
allowShort = input.bool(true, "Allow shorts", group=grpDir)

grpSess = "⑥ Sessions (kill zones)"
useSessions = input.bool(true, "Trade only London / NY", group=grpSess,
     tooltip="Restrict entries to the London and New York kill zones. Outside them, no new trades.")
sessTZ      = input.string("America/New_York", "Session timezone", group=grpSess,
     tooltip="Kill-zone times are interpreted in this timezone regardless of the symbol's exchange.")
londonSess  = input.session("0200-0500", "London kill zone", group=grpSess)
nySess      = input.session("0700-1000", "New York kill zone", group=grpSess)
emphasizeNY = input.bool(true, "Emphasize NY (stricter filter in London)", group=grpSess,
     tooltip="Require one extra confluence during London-only hours, so higher-volume NY setups are prioritised.")

grpViz  = "⑦ Markup"
showZone  = input.bool(true, "Show OTE zone + Fib", group=grpViz)
showFVG   = input.bool(true, "Show 1H FVG box",     group=grpViz)
showOB    = input.bool(true, "Show 1H order block", group=grpViz)
showTable = input.bool(true, "Show bias table",     group=grpViz)

// --------------------- HTF structure (Indication) ----------------------------
// Runs on the requested timeframe and returns [bias, legHigh, legLow].
// bias: 1 bullish, -1 bearish, 0 none. Leg = the impulse that broke structure.
f_structure() =>
    ph = ta.pivothigh(pivotLen, pivotLen)
    pl = ta.pivotlow(pivotLen, pivotLen)
    var float lastPH = na
    var float prevPH = na
    var float lastPL = na
    var float prevPL = na
    if not na(ph)
        prevPH := lastPH
        lastPH := ph
    if not na(pl)
        prevPL := lastPL
        lastPL := pl
    bull = not na(ph) and not na(prevPH) and ph > prevPH and not na(lastPL)
    bear = not na(pl) and not na(prevPL) and pl < prevPL and not na(lastPH)
    var int   b  = 0
    var float lh = na
    var float ll = na
    if bull
        b  := 1
        lh := ph
        ll := lastPL
    if bear
        b  := -1
        ll := pl
        lh := lastPH
    [b, lh, ll]

[biasD, legHiD, legLoD] = request.security(syminfo.tickerid, tfBias,    f_structure(), lookahead=barmerge.lookahead_off)
[bias4, legHi4, legLo4] = request.security(syminfo.tickerid, tfConfirm, f_structure(), lookahead=barmerge.lookahead_off)

// Bias must align across 1D and 4H.
aligned = not na(biasD) and biasD != 0 and biasD == bias4
dir     = aligned ? biasD : 0

// Choose which HTF leg carries the OTE / Fib markup.
useBiasLeg = oteSource == "Bias"
legHi = useBiasLeg ? legHiD : legHi4
legLo = useBiasLeg ? legLoD : legLo4

// -------------------------- OTE zone (Correction) ----------------------------
rng     = na(legHi) or na(legLo) ? na : legHi - legLo
oteMid  = na(rng) ? na : dir == 1 ? legHi - rng * 0.705   : dir == -1 ? legLo + rng * 0.705   : na

// -------- Entry selection: shallowest OTE level that clears the min R:R -------
// Stop = leg origin (± buffer); target = leg extreme (+ optional extension). A shallow
// entry sits nearer the extreme → smaller reward, larger risk → lower R:R. So we walk
// 0.618 → 0.705 → 0.786 and take the FIRST (shallowest) that still makes minRR.
equil       = na(rng) ? na : (legHi + legLo) / 2.0
tgtLong     = na(rng) ? na : legHi + rng * targetExt
tgtShort    = na(rng) ? na : legLo - rng * targetExt
slBaseLong  = na(rng) ? na : legLo - slBufTicks * syminfo.mintick
slBaseShort = na(rng) ? na : legHi + slBufTicks * syminfo.mintick

f_rrLong(f) =>
    e = legHi - rng * f
    r = e - slBaseLong
    r > 0 ? (tgtLong - e) / r : 0.0
f_rrShort(f) =>
    e = legLo + rng * f
    r = slBaseShort - e
    r > 0 ? (e - tgtShort) / r : 0.0

manFib = manualEntry == "0.618 (A)" ? fibA : manualEntry == "0.786 (C)" ? fibC : fibB
chosenFibLong  = na(rng) ? na : autoEntry ? (f_rrLong(fibA)  >= minRR ? fibA : f_rrLong(fibB)  >= minRR ? fibB : f_rrLong(fibC)  >= minRR ? fibC : na) : (f_rrLong(manFib)  >= minRR ? manFib : na)
chosenFibShort = na(rng) ? na : autoEntry ? (f_rrShort(fibA) >= minRR ? fibA : f_rrShort(fibB) >= minRR ? fibB : f_rrShort(fibC) >= minRR ? fibC : na) : (f_rrShort(manFib) >= minRR ? manFib : na)

limitLong  = na(chosenFibLong)  ? na : legHi - rng * chosenFibLong
limitShort = na(chosenFibShort) ? na : legLo + rng * chosenFibShort

// Entry zone (0.618..0.786) for the confluence-overlap test and shading.
ezHiLong  = na(rng) ? na : legHi - rng * fibA   // shallow edge (higher price)
ezLoLong  = na(rng) ? na : legHi - rng * fibC   // deep edge (lower price)
ezLoShort = na(rng) ? na : legLo + rng * fibA
ezHiShort = na(rng) ? na : legLo + rng * fibC
inDiscount = na(equil) ? false : not na(limitLong)  and limitLong  < equil
inPremium  = na(equil) ? false : not na(limitShort) and limitShort > equil

// Runner target multiple (the R:R entry gate is handled by chosenFib above).
lastR = numTPs == 1 ? tp1R : numTPs == 2 ? tp2R : tp3R

// Reset the "already entered this leg" flag whenever the HTF leg changes.
var bool  entered   = false
var float prevLegHi = na
var float prevLegLo = na
if legHi != prevLegHi or legLo != prevLegLo
    entered := false
prevLegHi := legHi
prevLegLo := legLo

// --------------------- 1H confluence: FVG + Order Block -----------------------
// Fair value gaps on the entry (chart) timeframe.
bullFVG = low  > high[2]
bearFVG = high < low[2]
fvgWindow  = 30
hasBullFVG = ta.barssince(bullFVG) <= fvgWindow
hasBearFVG = ta.barssince(bearFVG) <= fvgWindow

// Approximate order block: the last opposite-color candle before a displacement.
var float bullOBhi = na
var float bullOBlo = na
var float bearOBhi = na
var float bearOBlo = na
if bullFVG
    obi = close[2] < open[2] ? 2 : close[3] < open[3] ? 3 : 2
    bullOBhi := high[obi]
    bullOBlo := low[obi]
if bearFVG
    obi = close[2] > open[2] ? 2 : close[3] > open[3] ? 3 : 2
    bearOBhi := high[obi]
    bearOBlo := low[obi]

// -------------------- 1H liquidity sweep (stop raid) -------------------------
// A minor 1H swing low/high whose liquidity the correction takes before reversing.
phN = ta.pivothigh(sweepPivotLen, sweepPivotLen)
plN = ta.pivotlow(sweepPivotLen, sweepPivotLen)
var float lastMinorLow  = na
var float lastMinorHigh = na
if not na(plN)
    lastMinorLow  := plN
if not na(phN)
    lastMinorHigh := phN
bullSweep = not na(lastMinorLow)  and low  < lastMinorLow  and close > lastMinorLow
bearSweep = not na(lastMinorHigh) and high > lastMinorHigh and close < lastMinorHigh
hasBullSweep = ta.barssince(bullSweep) <= sweepWindow
hasBearSweep = ta.barssince(bearSweep) <= sweepWindow

// ---------------- Confluence ZONES for the golden-pocket overlap test ----------
// Each zone is a price band [lo, hi] with the bar it formed on. It counts toward the
// pocket-overlap test only if it formed within confWin bars and actually intersects
// the golden pocket — i.e. the confluence SITS IN the pocket, not merely nearby.

// FVG bands (bull gap = high[2]→low[0]; bear gap = high[0]→low[2]).
var float fvgBLo = na
var float fvgBHi = na
var int   fvgBBar = na
var float fvgSLo = na
var float fvgSHi = na
var int   fvgSBar = na
if bullFVG
    fvgBLo := high[2]
    fvgBHi := low[0]
    fvgBBar := bar_index
if bearFVG
    fvgSLo := high[0]
    fvgSHi := low[2]
    fvgSBar := bar_index

// Order-block formation bar (band is bullOBlo/hi, bearOBlo/hi from above).
var int obBBar = na
var int obSBar = na
if bullFVG
    obBBar := bar_index
if bearFVG
    obSBar := bar_index

// Inverse FVG (IFVG): a bear FVG closed through to the upside flips to bullish support
// (and vice versa). The old gap band becomes the new confluence.
var float ifvgBLo = na
var float ifvgBHi = na
var int   ifvgBBar = na
var float ifvgSLo = na
var float ifvgSHi = na
var int   ifvgSBar = na
if not na(fvgSHi) and close > fvgSHi and close[1] <= fvgSHi
    ifvgBLo := fvgSLo
    ifvgBHi := fvgSHi
    ifvgBBar := bar_index
if not na(fvgBLo) and close < fvgBLo and close[1] >= fvgBLo
    ifvgSLo := fvgBLo
    ifvgSHi := fvgBHi
    ifvgSBar := bar_index

// Rejection block: the WICK left when price traded into a level and was rejected, then
// displaced away (per your notes — wicks, not bodies). Bullish = long lower wick;
// band = [low, min(open,close)]. Bearish = long upper wick; band = [max(open,close), high].
body    = math.abs(close - open)
lowWick = math.min(open, close) - low
upWick  = high - math.max(open, close)
var float rejBLo = na
var float rejBHi = na
var int   rejBBar = na
var float rejSLo = na
var float rejSHi = na
var int   rejSBar = na
if lowWick > body and lowWick > 0
    rejBLo := low
    rejBHi := math.min(open, close)
    rejBBar := bar_index
if upWick > body and upWick > 0
    rejSLo := math.max(open, close)
    rejSHi := high
    rejSBar := bar_index

// Overlap test: fresh zone whose band intersects the golden pocket band.
f_hit(_zlo, _zhi, _zbar, _plo, _phi) =>
    not na(_zlo) and not na(_plo) and (bar_index - _zbar) <= confWin and _zlo <= _phi and _zhi >= _plo

bullPocketConf = f_hit(fvgBLo, fvgBHi, fvgBBar, ezLoLong, ezHiLong) or f_hit(bullOBlo, bullOBhi, obBBar, ezLoLong, ezHiLong) or f_hit(ifvgBLo, ifvgBHi, ifvgBBar, ezLoLong, ezHiLong) or f_hit(rejBLo, rejBHi, rejBBar, ezLoLong, ezHiLong)
bearPocketConf = f_hit(fvgSLo, fvgSHi, fvgSBar, ezLoShort, ezHiShort) or f_hit(bearOBlo, bearOBhi, obSBar, ezLoShort, ezHiShort) or f_hit(ifvgSLo, ifvgSHi, ifvgSBar, ezLoShort, ezHiShort) or f_hit(rejSLo, rejSHi, rejSBar, ezLoShort, ezHiShort)

// ------------------------------- Entries -------------------------------------
// Daily trade cap — reset the counter each new calendar day (exchange time).
var int tradesToday = 0
if ta.change(time("D")) != 0
    tradesToday := 0
underCap = tradesToday < maxTrades

// Kill-zone sessions (London / NY), interpreted in the chosen timezone.
inLondon  = not na(time(timeframe.period, londonSess, sessTZ))
inNY      = not na(time(timeframe.period, nySess, sessTZ))
inSession = not useSessions or inLondon or inNY

// Volume + confluence scoring. Volume is double-weighted so volume-backed setups win.
volAvg   = ta.sma(volume, volLen)
volOK    = volume > volAvg * volMult
inBullOB = not na(bullOBlo) and low  <= bullOBhi and low  >= bullOBlo
inBearOB = not na(bearOBlo) and high >= bearOBlo and high <= bearOBhi
bullConfl = (hasBullFVG ? 1 : 0) + (inBullOB ? 1 : 0) + (hasBullSweep ? 1 : 0) + (volOK ? 2 : 0)
bearConfl = (hasBearFVG ? 1 : 0) + (inBearOB ? 1 : 0) + (hasBearSweep ? 1 : 0) + (volOK ? 2 : 0)
// Emphasise NY: during London-only hours, demand one extra confluence.
reqConfl  = useSessions and emphasizeNY and inLondon and not inNY ? minConfl + 1 : minConfl

// Setup is "armed" once bias aligns, we're in session, confluence clears the quality
// bar, the R:R gate passes, and we're under the daily cap. While armed and flat, a
// resting LIMIT order sits at the OTE level — it fills only if price trades into it.
armLong  = allowLong  and dir == 1  and not entered and underCap and inSession and (not requireVol or volOK) and bullConfl >= reqConfl and (not requirePD or inDiscount) and (not requirePocketConf or bullPocketConf) and not na(limitLong)  and close > legLo and (not useFVG or hasBullFVG) and (not useSweep or hasBullSweep)
armShort = allowShort and dir == -1 and not entered and underCap and inSession and (not requireVol or volOK) and bearConfl >= reqConfl and (not requirePD or inPremium)  and (not requirePocketConf or bearPocketConf) and not na(limitShort) and close < legHi and (not useFVG or hasBearFVG) and (not useSweep or hasBearSweep)

// Position size from fixed-fractional risk: a full stop-out loses riskPct of equity.
// qty = (equity * riskPct%) / (stop distance in price * currency value per point).
f_qty(_limit, _sl) =>
    dist = math.abs(_limit - _sl)
    raw  = dist > 0 and syminfo.pointvalue > 0 ? (strategy.equity * riskPct / 100.0) / (dist * syminfo.pointvalue) : 0.0
    roundContr ? math.floor(raw) : raw

// Stored stop for the pending (or open) trade.
var float pendSLlong  = na
var float pendSLshort = na

if strategy.position_size == 0
    if armLong
        slPx  = legLo - slBufTicks * syminfo.mintick
        qtyL  = f_qty(limitLong, slPx)
        if qtyL > 0
            pendSLlong := slPx
            strategy.entry("Long", strategy.long, qty=qtyL, limit=limitLong)
        else
            strategy.cancel("Long")
    else
        strategy.cancel("Long")
    if armShort
        slPx  = legHi + slBufTicks * syminfo.mintick
        qtyS  = f_qty(limitShort, slPx)
        if qtyS > 0
            pendSLshort := slPx
            strategy.entry("Short", strategy.short, qty=qtyS, limit=limitShort)
        else
            strategy.cancel("Short")
    else
        strategy.cancel("Short")

// Fire the alert / lock the leg only when the limit actually fills.
filledLong  = strategy.position_size > 0 and strategy.position_size[1] <= 0
filledShort = strategy.position_size < 0 and strategy.position_size[1] >= 0

// Capture entry price, per-unit risk (R), and initial size on the fill bar.
var float entryPx  = na
var float riskPx   = na
var float initSize = na
if filledLong
    entryPx  := strategy.position_avg_price
    riskPx   := entryPx - pendSLlong
    initSize := math.abs(strategy.position_size)
    entered  := true
    tradesToday += 1
    alert('{"strategy":"ICC-OTE-MTF","ticker":"' + syminfo.tickerid + '","action":"buy","price":' + str.tostring(entryPx) + ',"sl":' + str.tostring(pendSLlong) + ',"tp1":' + str.tostring(entryPx + riskPx * tp1R) + ',"tp2":' + str.tostring(entryPx + riskPx * tp2R) + ',"tp3":' + str.tostring(entryPx + riskPx * tp3R) + ',"bias":"1D+4H bull","tf":"' + timeframe.period + '"}', alert.freq_once_per_bar)
if filledShort
    entryPx  := strategy.position_avg_price
    riskPx   := pendSLshort - entryPx
    initSize := math.abs(strategy.position_size)
    entered  := true
    tradesToday += 1
    alert('{"strategy":"ICC-OTE-MTF","ticker":"' + syminfo.tickerid + '","action":"sell","price":' + str.tostring(entryPx) + ',"sl":' + str.tostring(pendSLshort) + ',"tp1":' + str.tostring(entryPx - riskPx * tp1R) + ',"tp2":' + str.tostring(entryPx - riskPx * tp2R) + ',"tp3":' + str.tostring(entryPx - riskPx * tp3R) + ',"bias":"1D+4H bear","tf":"' + timeframe.period + '"}', alert.freq_once_per_bar)

// -------------------- Scaled take-profit + break-even ------------------------
// TP prices from the per-unit risk. The last active tranche is the "runner".
tp1Long = na(entryPx) ? na : entryPx + riskPx * tp1R
tp2Long = na(entryPx) ? na : entryPx + riskPx * tp2R
runLong = na(entryPx) ? na : entryPx + riskPx * lastR
tp1Short = na(entryPx) ? na : entryPx - riskPx * tp1R
tp2Short = na(entryPx) ? na : entryPx - riskPx * tp2R
runShort = na(entryPx) ? na : entryPx - riskPx * lastR

// Track which tranches have printed so we don't recreate a filled order.
var bool tp1hit = false
var bool tp2hit = false
if strategy.position_size == 0
    tp1hit := false
    tp2hit := false
if strategy.position_size > 0 and not na(tp1Long) and high >= tp1Long
    tp1hit := true
if strategy.position_size > 0 and numTPs >= 3 and not na(tp2Long) and high >= tp2Long
    tp2hit := true
if strategy.position_size < 0 and not na(tp1Short) and low <= tp1Short
    tp1hit := true
if strategy.position_size < 0 and numTPs >= 3 and not na(tp2Short) and low <= tp2Short
    tp2hit := true

// Staged stop protection:
//   after TP1  -> break-even (± offset), the runner is risk-free
//   after TP2  -> trail up to the TP1 price, locking in profit on the runner
beLong  = entryPx + beOffTicks * syminfo.mintick
beShort = entryPx - beOffTicks * syminfo.mintick
curStopLong  = tp2hit and trailTP2 ? tp1Long  : tp1hit and moveBE ? beLong  : pendSLlong
curStopShort = tp2hit and trailTP2 ? tp1Short : tp1hit and moveBE ? beShort : pendSLshort

q1 = initSize * tp1pct / 100.0
q2 = initSize * tp2pct / 100.0

if strategy.position_size > 0
    if numTPs == 1
        strategy.exit("Runner L", "Long", stop=curStopLong, limit=runLong)
    else
        if not tp1hit
            strategy.exit("TP1 L", "Long", qty=q1, stop=curStopLong, limit=tp1Long)
        if numTPs >= 3 and not tp2hit
            strategy.exit("TP2 L", "Long", qty=q2, stop=curStopLong, limit=tp2Long)
        strategy.exit("Runner L", "Long", stop=curStopLong, limit=runLong)
if strategy.position_size < 0
    if numTPs == 1
        strategy.exit("Runner S", "Short", stop=curStopShort, limit=runShort)
    else
        if not tp1hit
            strategy.exit("TP1 S", "Short", qty=q1, stop=curStopShort, limit=tp1Short)
        if numTPs >= 3 and not tp2hit
            strategy.exit("TP2 S", "Short", qty=q2, stop=curStopShort, limit=tp2Short)
        strategy.exit("Runner S", "Short", stop=curStopShort, limit=runShort)

// ------------------------------- Markup --------------------------------------
plot(showZone and dir != 0 ? oteMid : na, "OTE 0.705 (ref)", color=color.new(color.orange, 40), style=plot.style_linebr)
plot(showZone and dir != 0 ? legHi  : na, "Leg high", color=color.new(color.blue, 50), style=plot.style_linebr)
plot(showZone and dir != 0 ? legLo  : na, "Leg low",  color=color.new(color.blue, 50), style=plot.style_linebr)

// Entry zone (0.618–0.786) and the 50% equilibrium (premium/discount divider).
ezTop = dir == 1 ? ezHiLong : dir == -1 ? ezHiShort : na
ezBot = dir == 1 ? ezLoLong : dir == -1 ? ezLoShort : na
ez1 = plot(showZone and dir != 0 ? ezTop : na, "Entry zone top", color=color.new(color.yellow, 0), style=plot.style_linebr)
ez2 = plot(showZone and dir != 0 ? ezBot : na, "Entry zone bot", color=color.new(color.yellow, 0), style=plot.style_linebr)
fill(ez1, ez2, color=showZone and dir != 0 ? color.new(color.yellow, 75) : na, title="Entry zone")
plot(showZone and dir != 0 ? equil : na, "Equilibrium 50%", color=color.new(color.white, 40), style=plot.style_linebr)

// Live trade management: TP tranches + the current (possibly break-even) stop.
inPosLong  = strategy.position_size > 0
inPosShort = strategy.position_size < 0
inPos      = inPosLong or inPosShort
plot(inPos ? (inPosLong ? tp1Long : tp1Short) : na, "TP1", color=color.new(color.green, 0),  style=plot.style_linebr)
plot(inPos and numTPs >= 2 ? (inPosLong ? (numTPs >= 3 ? tp2Long : runLong) : (numTPs >= 3 ? tp2Short : runShort)) : na, "TP2", color=color.new(color.green, 30), style=plot.style_linebr)
plot(inPos and numTPs >= 3 ? (inPosLong ? runLong : runShort) : na, "TP3 (runner)", color=color.new(color.green, 55), style=plot.style_linebr)
plot(inPos ? (inPosLong ? curStopLong : curStopShort) : na, "Stop", color=tp1hit and moveBE ? color.new(color.yellow, 0) : color.new(color.red, 0), style=plot.style_linebr, linewidth=2)

// FVG box (entry timeframe)
if showFVG and bullFVG
    box.new(bar_index[2], low[0], bar_index + 3, high[2], border_color=color.new(color.teal, 40), bgcolor=color.new(color.teal, 88))
if showFVG and bearFVG
    box.new(bar_index[2], low[2], bar_index + 3, high[0], border_color=color.new(color.red, 40), bgcolor=color.new(color.red, 88))

// Order-block box (entry timeframe)
if showOB and bullFVG and not na(bullOBlo)
    box.new(bar_index - 3, bullOBhi, bar_index + 3, bullOBlo, border_color=color.new(color.green, 20), bgcolor=color.new(color.green, 85))
if showOB and bearFVG and not na(bearOBlo)
    box.new(bar_index - 3, bearOBhi, bar_index + 3, bearOBlo, border_color=color.new(color.maroon, 20), bgcolor=color.new(color.maroon, 85))

plot(showZone and dir != 0 ? (dir == 1 ? limitLong : limitShort) : na, "Limit entry", color=color.new(color.fuchsia, 0), style=plot.style_linebr, linewidth=2)
plotshape(filledLong,  title="Long fill",  style=shape.labelup,   location=location.belowbar, color=color.teal, text="ICC▲", textcolor=color.white, size=size.small)
plotshape(filledShort, title="Short fill", style=shape.labeldown, location=location.abovebar, color=color.red,  text="ICC▼", textcolor=color.white, size=size.small)
plotchar(useSweep and bullSweep, title="Bull sweep", char="⨯", location=location.belowbar, color=color.new(color.teal, 0), size=size.tiny)
plotchar(useSweep and bearSweep, title="Bear sweep", char="⨯", location=location.abovebar, color=color.new(color.red, 0),  size=size.tiny)

// Bias table
f_arrow(b) => b == 1 ? "▲ Bull" : b == -1 ? "▼ Bear" : "– None"
f_col(b)   => b == 1 ? color.teal : b == -1 ? color.red : color.gray
if showTable and barstate.islast
    curConfl  = dir == 1 ? bullConfl : dir == -1 ? bearConfl : 0
    sessTxt   = not useSessions ? "any" : inNY ? "NY" : inLondon ? "London" : "closed"
    sessCol   = inNY ? color.teal : inLondon ? color.aqua : useSessions ? color.gray : color.silver
    pdOK      = dir == 1 ? inDiscount : dir == -1 ? inPremium : false
    pdTxt     = dir == 1 ? (inDiscount ? "discount ✓" : "premium ✗") : dir == -1 ? (inPremium ? "premium ✓" : "discount ✗") : "–"
    pocketOK  = dir == 1 ? bullPocketConf : dir == -1 ? bearPocketConf : false
    chosenF   = dir == 1 ? chosenFibLong : dir == -1 ? chosenFibShort : na
    var table t = table.new(position.top_right, 2, 10, border_width=1)
    table.cell(t, 0, 0, "Bias " + tfBias,    text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 0, f_arrow(biasD),       text_color=f_col(biasD), bgcolor=color.new(color.black, 30))
    table.cell(t, 0, 1, "Confirm " + tfConfirm, text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 1, f_arrow(bias4),       text_color=f_col(bias4), bgcolor=color.new(color.black, 30))
    table.cell(t, 0, 2, "Aligned",            text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 2, aligned ? "YES" : "no", text_color=aligned ? color.teal : color.gray, bgcolor=color.new(color.black, 30))
    table.cell(t, 0, 3, "Session",            text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 3, sessTxt,              text_color=sessCol, bgcolor=color.new(color.black, 30))
    table.cell(t, 0, 4, "P / D zone",         text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 4, pdTxt,                text_color=pdOK ? color.teal : color.gray, bgcolor=color.new(color.black, 30))
    table.cell(t, 0, 5, "Conf @ zone",        text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 5, pocketOK ? "in zone ✓" : "none", text_color=pocketOK ? color.teal : color.gray, bgcolor=color.new(color.black, 30))
    table.cell(t, 0, 6, "Confluence",         text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 6, str.tostring(curConfl) + " / " + str.tostring(reqConfl) + (volOK ? " ⚡" : ""), text_color=curConfl >= reqConfl ? color.teal : color.gray, bgcolor=color.new(color.black, 30))
    table.cell(t, 0, 7, "Entry @",            text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 7, na(chosenF) ? "no 2:1" : str.tostring(chosenF), text_color=na(chosenF) ? color.gray : color.teal, bgcolor=color.new(color.black, 30))
    table.cell(t, 0, 8, "Setup",              text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 8, dir == 1 ? "LONG" : dir == -1 ? "SHORT" : "wait", text_color=f_col(dir), bgcolor=color.new(color.black, 30))
    table.cell(t, 0, 9, "Trades today",       text_color=color.white, bgcolor=color.new(color.black, 30))
    table.cell(t, 1, 9, str.tostring(tradesToday) + " / " + str.tostring(maxTrades), text_color=underCap ? color.teal : color.orange, bgcolor=color.new(color.black, 30))
