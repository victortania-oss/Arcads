# ── Copy to .env and fill in. NEVER commit your real .env. ──

# Shared secret that TradingView must send (?secret=... or in the JSON body).
# Make it long and random, e.g. `openssl rand -hex 24`.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Master safety switch. Leave false to log signals only (paper mode).
LIVE_TRADING=false

# Which adapter to use: paper | crypto
BROKER=paper

# Where signals are logged.
SIGNAL_LOG=signals.log

# ── Crypto (only used when BROKER=crypto and LIVE_TRADING=true) ──
CCXT_EXCHANGE=binance
CCXT_API_KEY=
CCXT_SECRET=
CCXT_SANDBOX=true
ORDER_QUOTE_AMOUNT=25
